# Copy this file to secrets.local.env and replace the dummy values.
# Never commit secrets.local.env.

# Vultr API token used by Pulumi to manage Vultr infrastructure.
# The same token is also used to create the Kubernetes Secret used by
# cert-manager for Vultr DNS-01 challenges.
VULTR_API_KEY="replace-with-a-vultr-api-key"

# PostgreSQL superuser password for the shared platform database.
POSTGRESQL_SUPERUSER_PASSWORD="replace-with-a-random-postgresql-superuser-password"

# Default application/database owner password for the shared platform database.
POSTGRESQL_APP_PASSWORD="replace-with-a-random-postgresql-application-password"

# Authentik PostgreSQL password and application secret key.
# Replace <DOMAIN_NAME_IDENTIFIER> with the uppercase domain identifier.
# Example: example.com -> EXAMPLE_COM
AUTHENTIK_<DOMAIN_NAME_IDENTIFIER>_POSTGRESQL_PASSWORD="replace-with-a-random-password"
AUTHENTIK_<DOMAIN_NAME_IDENTIFIER>_SECRET_KEY="replace-with-a-random-secret-key"
